{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2022"],
    "types": [],
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true
  },
  "include": ["./*.ts", "./*.d.ts"],
  "exclude": ["./**/*.test.ts", "./dist/**", "./node_modules/**"]
}
