{
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "auth": {
      "mode": "token"
    },
    "controlUi": {
      "allowedOrigins": [
        "https://openclaw.phhotel.vn",
        "https://openclaw-deu7.onrender.com"
      ]
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "featherless": {
        "baseUrl": "https://api.featherless.ai/v1",
        "apiKey": "${FEATHERLESS_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "Qwen/Qwen3-32B",
            "name": "Featherless Qwen3 32B",
            "input": ["text"],
            "reasoning": true,
            "contextWindow": 32768,
            "maxTokens": 4096
          }
        ]
      },
      "openrouter": {
        "baseUrl": "https://api.openrouter.ai/v1",
        "apiKey": "${OPENROUTER_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "nvidia/nemotron-3-embed-1b:free",
            "name": "OpenRouter Nemotron 3",
            "input": ["text"],
            "reasoning": true,
            "contextWindow": 16000,
            "maxTokens": 4096
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "featherless/Qwen/Qwen3-32B",
        "secondary": "openrouter/nvidia/nemotron-3-embed-1b:free"
      },
      "models": {
        "featherless/Qwen/Qwen3-32B": {
          "alias": "phhotel-main"
        },
        "openrouter/nvidia/nemotron-3-embed-1b:free": {
          "alias": "phhotel-openrouter"
        }
      }
    }
  },
  "skills": {
    "entries": {
      "phhotel-sales-agent": {
        "enabled": true
      }
    }
  }
}
